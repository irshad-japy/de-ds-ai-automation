# Azure Machine Learning workspace identity (no passwords/secrets are needed here)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-poc07-mlops
AZUREML_WORKSPACE_NAME=mlw-poc07-mlops
# Optional. Leave blank unless your organization requires a specific tenant.
AZURE_TENANT_ID=

# Authentication for local Windows POC. Run `az login` first.
# Supported values: cli | interactive | default
AZURE_AUTH_MODE=cli

# MLflow / POC names
MLFLOW_EXPERIMENT_NAME=poc07-shipment-delay
AZUREML_DATA_ASSET_NAME=shipment-delay-synthetic
AZUREML_MODEL_NAME=shipment-delay-model

# Optional Azure batch endpoint configuration
AZUREML_BATCH_COMPUTE_NAME=cpu-poc07
AZUREML_BATCH_VM_SIZE=Standard_DS2_v2
# Batch endpoint names must be unique in an Azure region. Change this before deployment.
AZUREML_BATCH_ENDPOINT_NAME=shipment-delay-batch-change-me
AZUREML_BATCH_DEPLOYMENT_NAME=blue

# Batch deployment runtime fix (recommended after Image build failed)
AZUREML_BATCH_DEPLOYMENT_NAME=blue-v2
AZUREML_BATCH_ENVIRONMENT_NAME=poc07-batch-mlflow-py311
