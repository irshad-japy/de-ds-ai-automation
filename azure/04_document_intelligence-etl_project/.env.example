# ---------------- Azure Storage ----------------
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account-name>
AZURE_STORAGE_CONTAINER=documents

# ---------------- Azure AI Document Intelligence ----------------
# Example: https://<resource-name>.cognitiveservices.azure.com/
DOCUMENTINTELLIGENCE_ENDPOINT=<your-document-intelligence-endpoint>

# LOCAL-BEGINNER OPTION ONLY: copy the key into your local .env file.
# Never commit .env. When deployed to Azure Functions, prefer Managed Identity.
DOCUMENTINTELLIGENCE_API_KEY=

# ---------------- Azure SQL ----------------
# Local passwordless example after `az login`:
# Server=<server>.database.windows.net;Database=<db>;Authentication=ActiveDirectoryDefault;Encrypt=yes;TrustServerCertificate=no;
AZURE_SQL_CONNECTIONSTRING=

# Deployed Function App passwordless example:
# Server=<server>.database.windows.net;Database=<db>;Authentication=ActiveDirectoryMSI;Encrypt=yes;TrustServerCertificate=no;

# ---------------- Validation ----------------
CRITICAL_CONFIDENCE_THRESHOLD=0.70
AMOUNT_TOLERANCE=0.05

# Set true if you want the batch runner to load validated invoices to Azure SQL.
ENABLE_SQL_LOAD=true
