# ==============================
# Microsoft Foundry
# ==============================
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5-mini
FOUNDRY_AGENT_NAME=poc06-agentic-data-assistant

# Azure AI Search connection INSIDE the Foundry project
SEARCH_CONNECTION_NAME=poc06-search-connection
SEARCH_INDEX_NAME=poc06-policy-index

# ==============================
# Tool backend called by agent/tools.py
# ==============================
# mock = no Azure Function required; useful for first local smoke test
# function = call deployed/local Azure Function endpoints
TOOL_BACKEND=mock
FUNCTION_BASE_URL=http://localhost:7071/api
FUNCTION_KEY=
FUNCTION_TIMEOUT_SECONDS=20

# ==============================
# Search index setup script
# ==============================
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# Only needed by search/setup_search_index.py. Keep secret out of Git.
AZURE_SEARCH_ADMIN_KEY=<search-admin-key>

# ==============================
# Optional telemetry
# ==============================
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=INFO
