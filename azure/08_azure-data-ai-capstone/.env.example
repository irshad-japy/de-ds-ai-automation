# =============================================================
# POC-08 environment file
# Copy this file to .env and fill only the sections you will use.
# NEVER commit .env.
# =============================================================

# -------------------- General --------------------
AZURE_AUTH_MODE=browser
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-poc08-capstone
AZURE_LOCATION=eastus

# -------------------- ADLS Gen2 --------------------
# Preferred passwordless settings:
ADLS_ACCOUNT_NAME=
ADLS_ACCOUNT_URL=https://<storage-account>.dfs.core.windows.net
ADLS_FILE_SYSTEM=datalake
# Beginner fallback only. Leave blank when using Entra/RBAC.
AZURE_STORAGE_CONNECTION_STRING=

# -------------------- Event Hubs --------------------
EVENTHUB_FULLY_QUALIFIED_NAMESPACE=<namespace>.servicebus.windows.net
EVENTHUB_NAME=shipment-events
EVENTHUB_CONSUMER_GROUP=$Default
# Beginner fallback only. Leave blank when using Entra/RBAC.
EVENTHUB_CONNECTION_STRING=

# -------------------- Document Intelligence --------------------
DOCUMENTINTELLIGENCE_ENDPOINT=https://<doc-intelligence-name>.cognitiveservices.azure.com/
DOCUMENTINTELLIGENCE_API_KEY=

# -------------------- Azure AI Search --------------------
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=capstone-knowledge
# Optional if using Search RBAC. Admin key is easiest for first POC run.
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_QUERY_KEY=
SEARCH_VECTOR_DIMENSIONS=1536

# -------------------- Azure OpenAI embeddings --------------------
# Embeddings use the Azure OpenAI v1 endpoint, not the Foundry project endpoint.
AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# -------------------- Microsoft Foundry project --------------------
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini
# Optional: only for ai/agent/foundry_agent_runner.py after you create an agent in Foundry.
FOUNDRY_AGENT_NAME=

# -------------------- Azure SQL optional serving path --------------------
# Example with interactive Entra authentication on Windows:
# Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<db>;Encrypt=yes;TrustServerCertificate=no;Authentication=ActiveDirectoryInteractive;
AZURE_SQL_ODBC_CONNECTION_STRING=

# -------------------- Optional POC-07 MLflow --------------------
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_URI=
